DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_scheduler_cn?schema=public"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_PATH=""
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMe_StrongPassword_123!"
ADMIN_BOOTSTRAP_NAME="超级管理员"
SESSION_TTL_DAYS="7"
SESSION_COOKIE_SECURE="false"
# Set true only when a trusted reverse proxy overwrites X-Real-IP. Production
# additionally requires APP_URL to use HTTPS regardless of this setting.
TRUST_PROXY="false"
CANDIDATE_ACCESS_TOKEN_TTL_MINUTES="30"
CANDIDATE_SESSION_TTL_DAYS="14"
CANDIDATE_AUTH_DEV_PREVIEW="false"
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Required in production; encrypts queued one-time access-link email content.
CANDIDATE_ACCESS_ENCRYPTION_KEY=""
MAILATO_COMMAND="mailato"
MAILATO_DRY_RUN="true"
EMAIL_OUTBOX_BATCH_SIZE="20"
APPOINTMENT_REMINDER_HOURS="24,1"
STAFF_NOTIFICATION_LOCALE="zh-CN"
AUTH_ARTIFACT_RETENTION_DAYS="7"
EMAIL_CONTENT_RETENTION_DAYS="90"
AUDIT_LOG_RETENTION_DAYS="365"
