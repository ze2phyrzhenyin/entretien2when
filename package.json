{
  "name": "interview-scheduler-cn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "python3 scripts/i18n/check_catalogs.py src/i18n/messages/zh-CN/core.json src/i18n/messages/en/core.json && python3 scripts/i18n/check_catalogs.py src/i18n/messages/zh-CN/legacy.json src/i18n/messages/en/legacy.json && python3 scripts/i18n/check_explicit_ui.py && node scripts/i18n/check-fragmented-jsx.mjs && node scripts/i18n/generate-catalogs.mjs --check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed:demo": "tsx scripts/db-seed-demo.ts",
    "email:outbox": "tsx scripts/process-email-outbox.ts",
    "data:prune": "tsx scripts/prune-retained-data.ts",
    "admin:assign-group": "tsx scripts/assign-admin-group.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "auth:revoke": "tsx scripts/revoke-auth-artifacts.ts",
    "app:doctor": "bash scripts/doctor.sh",
    "check": "bash scripts/check.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "eslint-config-prettier": "^9.1.2",
    "postcss": "8.5.24",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}
